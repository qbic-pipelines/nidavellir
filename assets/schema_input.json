{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/nidavellir/master/assets/schema_input.json",
    "title": "nf-core/nidavellir pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "image_path": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+$",
                "errorMessage": "Image path must be provided and cannot contain spaces"
            },
            "omero_id": {
                "type": "string",
                "pattern": "^$|^\\S+$",
                "errorMessage": "OMERO identifier cannot contain spaces"
            }
        },
        "required": ["sample", "image_path"]
    }
}
